# Copy to .env and fill in real values. Never commit .env.
# Prisma and Next.js both read .env at the project root.

# --- Database -----------------------------------------------------------------
# Development (default): a local PostgreSQL 17 server on this computer.
# Both URLs point at the same local database; the app user needs CREATEDB so
# `prisma migrate dev` can create its temporary shadow database.
DATABASE_URL="postgresql://joy_palma:PASSWORD@localhost:5432/joy_palma_dev?schema=public"
DIRECT_URL="postgresql://joy_palma:PASSWORD@localhost:5432/joy_palma_dev?schema=public"

# Separate database for integration tests (Phase 6+). Never point this at real data.
TEST_DATABASE_URL="postgresql://joy_palma:PASSWORD@localhost:5432/joy_palma_test?schema=public"

# Production (Phase 11): switch both URLs to Neon.
#   DATABASE_URL = Neon *pooled* string (host contains "-pooler"), used at runtime
#   DIRECT_URL   = Neon *direct* string, used by Prisma Migrate
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/joy_palma?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/joy_palma?sslmode=require"

# --- Auth.js ------------------------------------------------------------------
# Random secret used to sign sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# --- Seed (pnpm db:seed) -----------------------------------------------------
# The first Owner account. Use a real email and a strong password in production.
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="change-me-to-a-strong-password"
# "true" adds demo users, products and 12 months of sales. Always "false" in production.
SEED_DEMO="false"
