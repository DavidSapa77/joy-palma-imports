# Copy to .env and fill in real values. Never commit .env.
# Prisma and Next.js both read .env at the project root.

# --- Database (Neon PostgreSQL) ---------------------------------------------
# Pooled connection string (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/joy_palma?sslmode=require"
# Direct (non-pooled) connection string — used by Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/joy_palma?sslmode=require"

# --- Auth.js ------------------------------------------------------------------
# Random secret used to sign sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# --- Seed (pnpm db:seed) -----------------------------------------------------
# The first Owner account. Use a real email and a strong password in production.
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="change-me-to-a-strong-password"
# "true" adds demo users, products and 12 months of sales. Always "false" in production.
SEED_DEMO="false"
